name: Build Windows EXE
on:
  workflow_dispatch:
  push:
    branches: [main]
jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: python -m pip install pyinstaller
      - run: python -m PyInstaller --noconfirm --clean --onefile --windowed --name MUSTAFA_ALJADY_Samsung_Tool mustafa_samsung_tool.py
      - uses: actions/upload-artifact@v4
        with:
          name: MUSTAFA_ALJADY_Samsung_Tool
          path: dist/MUSTAFA_ALJADY_Samsung_Tool.exe
